<!DOCTYPE html>
<html lang="es">

<head>
    <title>CROCHI - Boletas</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">

    <main class="main container">
        <div class="row justify-content-center mt-5">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-4">
                <div class="text-center fw-bold mb-3">
                    <%- boleta.emisor.nombreComercial %>
                    <br>
                    <%- boleta.emisor.razonSocial %>
                    <br>
                    RUC: <%- boleta.emisor.ruc %>
                </div>
                <div class="text-center fw-bold mb-3">
                    <img src="/img/logo-grande.svg" width="50%">
                </div>
                <div class="text-center mb-3">
                    <%- boleta.emisor.direccion.direccionCompleta %>
                    <br>
                    <%- boleta.emisor.direccion.distrito %> - <%- boleta.emisor.direccion.provincia %> - <%- boleta.emisor.direccion.departamento %>
                </div>
                <div class="text-center fw-bold mb-3">
                    BOLETA DE VENTA ELECTRÓNICA
                    <br>
                    <%- boleta.comprobante.serie %>-<%- boleta.comprobante.correlativo %>
                </div>
                <div class="mb-3">
                    <b>Cliente: </b><%- boleta.cliente.nombre %>
                    <br>
                    <b>Documento: </b><%- boleta.cliente.numeroDocumento %>
                    <br>
                    <b>Fecha: </b><%- new Date(boleta.comprobante.fechaEmision).toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                </div>
                <div class="mb-3">
                   <table class="table align-middle">
                        <thead class="text-center">
                            <tr>
                                <th scope="col">Producto</th>
                                <th scope="col">Cant.</th>
                                <th scope="col">Unit.</th>
                                <th scope="col">Total</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <% for (var producto of boleta.productos) { %>
                            <tr>
                                <td><%- producto.producto.descripcion %></td>
                                <td class="text-center"><%- producto.cantidad %></td>
                                <td class="text-center"><%- producto.precioUnitario.toFixed(2) %></td>
                                <td class="text-center"><%- producto.subtotal.toFixed(2) %></td>
                            </tr>
                            <% } %>
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr>
                                <th scope="col" colspan="3">Total a pagar</th>
                                <th class="text-center"><%- boleta.totales.total.toFixed(2) %></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="text-center mb-3">
                    <%- boleta.comprobante.nota %>
                </div>
                <div class="text-center mb-3">
                    Representación impresa de la boleta de venta electrónica emitida en SUNAT
                    <br>
                    Consultar en https://<%- process.env.HOST %>/boleta
                </div>
                <div class="text-center fw-bold mb-3">
                    Atención al cliente vía WhatsApp
                    <br>
                    +51 966 417 505
                    <br>
                </div>
                <div class="text-center fw-bold mb-3">
                    MUCHAS GRACIAS POR SU COMPRA
                </div>
                <div class="text-center mt-5">
                    <button class="btn btn-lg d-print-none" onclick="window.print();">
                        <i class="bi bi-printer"></i>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/script') %>
</body>

</html>
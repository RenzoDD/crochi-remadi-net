<!DOCTYPE html>
<html lang="en">

<head>
    <title>Crochi Perú - Admin</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">
    <%- include('../partials/header', { navbar: 'admin' , item: 'pedidos' }) %>

    <main class="main container">
        <nav class="my-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item"><a href="/admin/pedidos">Pedidos</a></li>
                <li class="breadcrumb-item"><a href="/admin/pedidos/<%- pedido.Codigo %>"><%- pedido.Codigo %></a></li>
                <li class="breadcrumb-item active">Editar</li>
            </ol>
        </nav>
        <form action="/admin/pedidos/editar" method="post">
            <div class="row mb-3">
                <div class="col-md-6 mb-4">
                    <label class="fw-bold">Cliente</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control" id="cliente-input" value="<%- cliente.Nombre %>" list="clientes" oninput="SeleccionarCliente()" autocomplete="off">
                        <input type="hidden" class="form-control" id="cliente" name="cliente" required>
                        <datalist id="clientes">
                            <% for (var cliente of clientes) { %>
                            <option id="cliente-<%- cliente.ClienteId %>" value="<%- cliente.Nombre %>">
                                <% } %>
                        </datalist>
                        <script>
                            function SeleccionarCliente() {
                                var input = document.getElementById("cliente-input");
                                var cliente = document.getElementById("cliente");
                                var icono = document.getElementById("cliente-result");

                                cliente.value = "";
                                input.setCustomValidity('Cliente Inválido');
                                icono.innerHTML = '<i class="bi bi-exclamation-octagon"></i>';

                                const valor = input.value.trim().toUpperCase();
                                const opciones = document.querySelectorAll("#clientes option");

                                opciones.forEach(opt => {
                                    if (opt.value.toUpperCase() === valor) {
                                        cliente.value = opt.id.replace("cliente-", "");
                                        input.setCustomValidity('');
                                        icono.innerHTML = '<i class="bi bi-check-circle"></i>';
                                    }
                                });
                            }
                            document.addEventListener('DOMContentLoaded', SeleccionarCliente);
                            window.addEventListener("pageshow", SeleccionarCliente);
                        </script>
                        <span class="input-group-text" id="cliente-result"><i class="bi bi-exclamation-octagon"></i></span>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <label for="fecha" class="fw-bold">Fecha Entrega</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                        <input type="date" id="fecha" name="fecha" value="<%- new Date(pedido.FechaEntrega).toISOString().split('T')[0] %>" class="form-control" required>
                    </div>
                </div>
                <div class="col-12 mb-4">
                    <div class="mb-3">
                        <label for="productos" class="fw-bold">Productos</label>
                        <div class="input-group input-group-lg">
                            <select id="producto" class="form-select">
                                <option selected disabled></option>
                                <% for (var producto of productos) { %>
                                <option value="<%- producto.ProductoId %>" precio="<%- producto.Precio %>"><%- producto.Nombre %></option>
                                <% } %>
                            </select>
                            <button type="button" class="btn btn-primary" onclick="AgregarProducto()">
                                <i class="bi bi-plus-circle"></i>
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover  mb-0">
                            <thead class="align-middle">
                                <tr>
                                    <th scope="col">Nombre</th>
                                    <th scope="col" class="text-center" style="width: 100px; min-width: 100px; max-width: 100px;">Cant.</th>
                                    <th scope="col" class="text-center" style="width: 150px; min-width: 150px; max-width: 150px;">P. Unit.</th>
                                    <th scope="col" class="text-center" style="width: 75px; min-width: 75px; max-width: 75px;">Subtotal</th>
                                    <th scope="col" class="text-center" style="width: 75px; min-width: 75px; max-width: 75px;"></th>
                                </tr>
                            </thead>
                            <tbody class="align-middle" id="lista-productos" style="white-space: nowrap">
                                <% var n = 0; %>
                                <% for (var detalle of detalles) { %>
                                <tr id="detalle-<%- n %>">
                                    <td>
                                        <input type="hidden" name="detalle-id-<%- n %>" value="<%- detalle.DetalleId %>" required>
                                        <input type="hidden" name="detalle-producto-<%- n %>" value="<%- detalle.ProductoId %>" required>
                                        <%- productos.find(p => p.ProductoId === detalle.ProductoId).Nombre %>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control text-center" min="1" step="1" id="detalle-cantidad-<%- n %>" name="detalle-cantidad-<%- n %>" value="<%- detalle.Cantidad %>" oninput="CalcularTotales()" required="">
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <span class="input-group-text">S/</span>
                                            <input type="number" class="form-control text-center" min="0" step="0.01" id="detalle-precio-<%- n %>" name="detalle-precio-<%- n %>" value="<%- detalle.PrecioUnitario %>" oninput="CalcularTotales()" required="">
                                        </div>
                                    </td>
                                    <td id="detalle-subtotal-<%- n %>">S/ <%- (detalle.Cantidad * detalle.PrecioUnitario).toFixed(2) %></td>
                                    <td>
                                        <button type="button" class="btn btn-sm" onclick="EliminarProducto(<%- n %>)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% n++ %>
                                <% } %>
                            </tbody>
                            <caption id="caption">
                                Se ha registrado <%- detalles.length %> item(s)
                            </caption>
                            <script>
                                let n = <%- n %>;
                                function AgregarProducto() {
                                    var producto = document.getElementById('producto');
                                    if (!producto.value) return;

                                    var option = producto.options[producto.selectedIndex];
                                    var id = producto.value;
                                    var precio = option.getAttribute('precio');
                                    var nombre = option.text;

                                    producto.value = "";

                                    const template = document.createElement('template');
                                    template.innerHTML = `
                                        <tr id="detalle-${n}">
                                            <td>
                                                <input type="hidden" name="detalle-producto-${n}" value="${id}" required>
                                                ${nombre}
                                            </td>
                                            <td>
                                                <input type="number" class="form-control  text-center" min="1" step="1" id="detalle-cantidad-${n}" name="detalle-cantidad-${n}" value="1" oninput="CalcularTotales()" required>
                                            </td>
                                            <td>
                                                <div class="input-group">
                                                    <span class="input-group-text">S/</span>
                                                    <input type="number" class="form-control text-center" min="0" step="0.01" id="detalle-precio-${n}" name="detalle-precio-${n}" value="${precio}" oninput="CalcularTotales()" required>
                                                </div>
                                            </td>
                                            <td id="detalle-subtotal-${n}">
                                                S/ -
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm" onclick="EliminarProducto(${n})">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                        `.trim();
                                    n++;
                                    var lista = document.getElementById('lista-productos');
                                    lista.appendChild(template.content.firstChild);

                                    if (lista.children.length == 0)
                                        document.getElementById('caption').innerHTML = 'No se han agregado items';
                                    else
                                        document.getElementById('caption').innerHTML = `Se ha registrado ${lista.children.length} item(s)`;

                                    CalcularTotales();
                                }
                                function EliminarProducto(id) {
                                    document.getElementById('detalle-' + id).remove();

                                    var lista = document.getElementById('lista-productos');
                                    if (lista.children.length == 0) {
                                        document.getElementById('caption').innerHTML = 'No se han agregado items';
                                    }
                                    else
                                        document.getElementById('caption').innerHTML = `Se ha registrado ${lista.children.length} item(s)`;

                                    CalcularTotales();
                                }
                                function CalcularTotales() {
                                    var lista = document.getElementById('lista-productos');
                                    if (lista.children.length == 0)
                                        document.getElementById('producto').setCustomValidity('Debe agregar al menos un producto');
                                    else
                                        document.getElementById('producto').setCustomValidity('');

                                    var total = 0;
                                    for (var i = 0; i < n; i++) {
                                        var cantidad = document.getElementById('detalle-cantidad-' + i);
                                        var precio = document.getElementById('detalle-precio-' + i);

                                        if (!cantidad || !precio) continue;

                                        var cantidad = parseInt(cantidad.value);
                                        var precio = parseFloat(precio.value);

                                        if (isNaN(cantidad) || isNaN(precio)) {
                                            document.getElementById('detalle-subtotal-' + i).innerHTML = 'S/ -';
                                            continue;
                                        }

                                        var subtotal = (cantidad * precio).toFixed(2);
                                        if (precio == 0)
                                            document.getElementById('detalle-subtotal-' + i).innerHTML = `<span class="badge rounded-pill bg-primary">Cortesía</span>`
                                        else
                                            document.getElementById('detalle-subtotal-' + i).innerHTML = 'S/ ' + subtotal;

                                        total += parseFloat(subtotal);
                                    }

                                    document.getElementById('total').value = total.toFixed(2);

                                    var adelanto = document.getElementById('adelanto').value || 0;
                                    if (adelanto > total)
                                        document.getElementById('adelanto').setCustomValidity('El adelanto no puede ser mayor que el total');
                                    else
                                        document.getElementById('adelanto').setCustomValidity('');
                                }

                                document.addEventListener('DOMContentLoaded', CalcularTotales);
                            </script>
                        </table>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <label for="adelanto" class="fw-bold">Adelanto</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">S/</span>
                        <input type="number" id="adelanto" name="adelanto" value="<%- pedido.MontoAdelanto.toFixed(2) %>" class="form-control" min="0" step="0.01">
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <label for="total" class="fw-bold">Total</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">S/</span>
                        <input type="number" id="total" class="form-control form-control-lg" readonly>
                    </div>
                </div>
                <div class="col-12 mb-4">
                    <label for="comentario" class="fw-bold">Comentario</label>
                    <textarea id="comentario" name="comentario" class="form-control form-control-lg"><%- pedido.Comentario || '' %></textarea>
                </div>
                <div class="col-12">
                    <div class="d-grid gap-2 col-6 mx-auto">
                        <input type="hidden" name="pedido" value="<%- pedido.PedidoId %>">
                        <button class="btn btn-primary">Editar</button>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <%- include('../partials/script') %>
</body>

</html>
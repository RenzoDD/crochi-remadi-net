<!DOCTYPE html>
<html lang="es">

<head>
    <title>Crochi Perú - Admin</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">
    <%- include('../partials/header', { navbar: 'admin' , item: 'pedidos' }) %>

    <main class="main container">
        <nav class="my-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item"><a href="/admin/pedidos">Pedidos</a></li>
                <li class="breadcrumb-item active"><%- pedido.Codigo %></li>
            </ol>
        </nav>
        <div class="text-end mb-3">
            <a href="/admin/pedidos/<%- pedido.Codigo %>/editar" class="btn">
                <i class="bi bi-pencil"></i>
            </a>
        </div>
        <div class="row mb-3">
            <div class="col-md-6 mb-4">
                <label class="fw-bold">Cliente</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" value="<%- cliente.Nombre %>" class="form-control" readonly>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <label for="fecha" class="fw-bold">Fecha Entrega</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                    <input type="text" value="<%- new Date(pedido.FechaEntrega).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' }) %>" class="form-control" readonly>
                </div>
            </div>
            <div class="col-12 mb-3">
                <label class="fw-bold">Productos</label>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="align-middle">
                            <tr>
                                <th scope="col" colspan="2">Nombre</th>
                                <th scope="col" class="text-center" style="width: 100px; min-width: 100px; max-width: 100px;">Cantidad</th>
                                <th scope="col" class="text-center" style="width: 100px; min-width: 100px; max-width: 100px;">P. Unit.</th>
                                <th scope="col" class="text-center" style="width: 100px; min-width: 100px; max-width: 100px;">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="align-middle" style="white-space: nowrap">
                            <% for (var detalle of detalles) { %>
                            <tr>
                                <% var producto = productos.find(x => x.ProductoId == detalle.ProductoId) %>
                                <% var estado = estados.find(x => x.EstadoId == detalle.EstadoId) %>
                                <td>
                                    <%- producto.Nombre %>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-<%- estado.Color %>">
                                        <%- estado.Nombre %>
                                    </span>
                                    <button class="btn btn-sm" type="button" onclick="CambiarEstado(<%- detalle.DetalleId %>, <%- detalle.EstadoId %>, '<%- producto.Nombre %>')" data-bs-toggle="modal" data-bs-target="#actualizar-estado">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                                <td class="text-center"><%- detalle.Cantidad %></td>
                                <td class="text-end">S/ <%- detalle.PrecioUnitario.toFixed(2) %></td>
                                <td class="text-end">S/ <%- (detalle.Cantidad * detalle.PrecioUnitario).toFixed(2) %></td>
                                <td></td>
                            </tr>
                            <% } %>
                        </tbody>
                        <caption id="caption">
                            Se ha registrado <%- detalles.length %> item(s)
                        </caption>
                    </table>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <label for="adelanto" class="fw-bold">Adelanto</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">S/</span>
                    <input type="number" value="<%- pedido.MontoAdelanto.toFixed(2) %>" class="form-control" readonly>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <label for="total" class="fw-bold">Total</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">S/</span>
                    <input type="number" id="total" value="<%- pedido.MontoTotal.toFixed(2) %>" class="form-control" readonly>
                </div>
            </div>
            <% if (pedido.Comentario) { %>
            <div class="col-12 mb-4">
                <label for="comentario" class="fw-bold">Comentario</label>
                <textarea id="comentario" name="comentario" class="form-control form-control-lg" readonly><%- pedido.Comentario %></textarea>
            </div>
            <% } %>
            <div class="col-12 mb-3">
                <label class="fw-bold">Boletas</label>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="align-middle">
                            <tr>
                                <th scope="col">Número</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Emisión</th>
                                <th scope="col">Monto</th>
                                <th>
                                    <button class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#registrar-boleta">
                                        <i class="bi bi-cloud-upload"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="align-middle" style="white-space: nowrap">
                            <% for (var boleta of boletas) { %>
                            <tr>
                                <td class="fw-bold"><%- boleta.Numero %></td>
                                <td><%- boleta.Cliente %></td>
                                <td><%- new Date(boleta.Emision).toLocaleDateString('es-PE', { day: '2-digit', month: 'long', year: 'numeric' }) %></td>
                                <td>S/ <%- boleta.Monto.toFixed(2) %></td>
                                <th>
                                    <button class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#eliminar-boleta" onclick="EliminarBoleta(<%- boleta.BoletaId %>, '<%- boleta.Numero %>')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </th>
                            </tr>
                            <% } %>
                        </tbody>
                        <caption id="caption">
                            Se ha registrado <%- boletas.length %> boletas(s)
                        </caption>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="actualizar-estado" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form action="/admin/pedidos/actualizar-estado" method="post" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Actualizar Estado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="fw-bold">Producto</label>
                        <input type="text" id="actualizar-estado-producto" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label for="actualizar-estado-estado" class="fw-bold">Estado</label>
                        <select class="form-select" id="actualizar-estado-estado" name="estado">
                            <% for (var estado of estados) { %>
                            <option value="<%- estado.EstadoId %>"><%- estado.Nombre %></option>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <input type="hidden" id="actualizar-estado-id" name="id">
                    <button class="btn btn-primary">Actualizar</button>
                </div>
                <script>
                    function CambiarEstado(id, estado, producto) {
                        document.getElementById('actualizar-estado-id').value = id;
                        document.getElementById('actualizar-estado-estado').value = estado;
                        document.getElementById('actualizar-estado-producto').value = producto;
                    }
                </script>
            </form>
        </div>
    </div>
    <div class="modal fade" id="registrar-boleta" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form action="/admin/boletas/registrar" method="post" class="modal-content" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Boleta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="fw-bold">Boleta XML</label>
                        <input type="file" id="registrar-boleta-archivo" class="form-control" name="archivo" accept=".xml">
                    </div>
                </div>
                <div class="modal-footer">
                    <input type="hidden" id="registrar-boleta-pedido" name="pedido" value="<%- pedido.PedidoId %>">
                    <button class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal fade" id="eliminar-boleta" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form action="/admin/boletas/eliminar" method="post" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar Boleta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="fw-bold">Boleta</label>
                        <input type="text" id="eliminar-boleta-numero" class="form-control" disabled>
                    </div>
                </div>
                <div class="modal-footer">
                    <input type="hidden" id="eliminar-boleta-id" name="boleta">
                    <button class="btn btn-danger">Eliminar</button>
                </div>
                <script>
                    function EliminarBoleta(boleta, numero) {
                        document.getElementById('eliminar-boleta-numero').value = numero;
                        document.getElementById('eliminar-boleta-id').value = boleta;
                    }
                </script>
            </form>
        </div>
    </div>

    <%- include('../partials/script') %>
</body>

</html>
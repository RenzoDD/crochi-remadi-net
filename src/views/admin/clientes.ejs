<!DOCTYPE html>
<html lang="en">

<head>
    <title>Crochi Perú - Admin</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">
    <%- include('../partials/header', { navbar: 'admin' , item: 'clientes' }) %>

    <main class="main container">
        <nav class="my-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item active">Clientes</li>
            </ol>
        </nav>
		<div class="my-3 text-end">
			<a href="/admin/clientes/registrar" class="btn btn-primary">
				<i class="bi bi-plus-circle"></i> Registrar cliente
			</a>
		</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">WhatsApp</th>
                    <th scope="col">Celular</th>
                    </tr>
                </thead>
                <tbody>
                    <% var n = 1 %>
                    <% for (var cliente of clientes) { %>
                    <tr>
                        <th scope="row"><%- n++ %></th>
                        <td><%- cliente.Nombre %></td>
                        <td><%- cliente.WhatsApp %></td>
                        <td><%- cliente.Celular %></td>
                    </tr>
                    <% } %>
                </tbody>
                <caption>
                    Se encontró <%- clientes.length %> cliente(s)
                </caption>
            </table>
        </div>
    </main>

    <%- include('../partials/script') %>
</body>

</html>
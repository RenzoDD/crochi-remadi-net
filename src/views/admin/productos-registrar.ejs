<!DOCTYPE html>
<html lang="en">

<head>
    <title>Crochi Perú - Admin</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">
    <%- include('../partials/header', { navbar: 'admin' , item: 'productos' }) %>

    <main class="main container">
        <nav class="my-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item"><a href="/admin/productos">Productos</a></li>
                <li class="breadcrumb-item active">Registrar</li>
            </ol>
        </nav>
        <form action="/admin/productos/registrar" method="post">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <label for="nombre" class="fw-bold">Nombre</label>
                    <input type="text" id="nombre" name="nombre" class="form-control form-control-lg" required>
                </div>
                <div class="col-md-6 mb-4">
                    <label for="precio" class="fw-bold">Precio</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">S/</span>
                        <input type="number" id="precio" name="precio" class="form-control" min="0" step="0.01" required>
                    </div>
                </div>
                <div class="col-12">
                    <div class="d-grid gap-2 col-6 mx-auto">
                        <button class="btn btn-primary">Registrar</button>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <%- include('../partials/script') %>
</body>

</html>
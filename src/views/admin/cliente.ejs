<!DOCTYPE html>
<html lang="es">

<head>
    <title>Crochi - Admin</title>
    <%- include('../partials/head') %>
</head>

<body class="index-page">
    <%- include('../partials/header', { navbar: 'admin' , item: 'clientes' }) %>

    <main class="main container">
        <nav class="my-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                <li class="breadcrumb-item"><a href="/admin/clientes">Cliente</a></li>
                <li class="breadcrumb-item active"><%- cliente.Nombre %></li>
            </ol>
        </nav>
		<div class="my-3 text-end">
            <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#actualizar">
                <i class="bi bi-pencil"></i>
            </button>
		</div>
        <div class="row">
            <div class="col-12 mb-4">
                <label for="nombre" class="fw-bold">Nombre</label>
                <input type="text" value="<%- cliente.Nombre %>" class="form-control form-control-lg" readonly>
            </div>
            <div class="col-md-4 mb-4">
                <label for="dni" class="fw-bold">DNI</label>
                <input type="text" value="<%- cliente.DNI %>" class="form-control form-control-lg" readonly>
            </div>
            <div class="col-md-4 mb-4">
                <label for="whatsapp" class="fw-bold">WhatsApp</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text">@</span>
                    <input type="text" value="<%- cliente.WhatsApp ? cliente.WhatsApp.substring(1) : '' %>" class="form-control form-control-lg" readonly>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <label for="celular" class="fw-bold">Celular</label>
                <input type="text" value="<%- cliente.Celular %>" class="form-control form-control-lg" readonly>
            </div>
        </div>
    </main>

    <div class="modal fade" id="actualizar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form action="/admin/clientes/actualizar" method="post" class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">
                        <i class="bi bi-pencil"></i> Actualizar Cliente
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombre" class="fw-bold">Nombre</label>
                        <input type="text" id="nombre" name="nombre" value="<%- cliente.Nombre %>" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="dni" class="fw-bold">DNI</label>
                        <input type="text" id="dni" name="dni" value="<%- cliente.DNI %>" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label for="whatsapp" class="fw-bold">WhatsApp</label>
                        <div class="input-group">
                            <span class="input-group-text">@</span>
                            <input type="text" id="whatsapp" value="<%- cliente.WhatsApp ? cliente.WhatsApp.substring(1) : '' %>" name="whatsapp" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="celular" class="fw-bold">Celular</label>
                        <input type="text" id="celular" name="celular" value="<%- cliente.Celular %>" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <input type="hidden" id="cliente" name="cliente" value="<%- cliente.ClienteId %>">
                    <button class="btn btn-primary">Actualizar</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/script') %>
</body>

</html>